{
  "rewrites": [
    {
      "source": "/api/ai-chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/api/diagnosis-count",
      "destination": "/api/diagnosis-count"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/admin-metrics",
      "destination": "/api/admin-metrics"
    },
    {
      "source": "/api/:match*",
      "destination": "https://heartsync-5tbs.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
