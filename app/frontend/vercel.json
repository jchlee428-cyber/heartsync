{
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai-chat",
      "destination": "/api/ai-chat"
    },
    {
      "source": "/api/diagnosis-count",
      "destination": "/api/diagnosis-count"
    },
    {
      "source": "/api/reviews",
      "destination": "/api/reviews"
    },
    {
      "source": "/api/admin-metrics",
      "destination": "/api/admin-metrics"
    },
    {
      "source": "/api/user-sync",
      "destination": "/api/user-sync"
    },
    {
      "source": "/api/toss-confirm",
      "destination": "/api/toss-confirm"
    },
    {
      "source": "/api/alimtalk",
      "destination": "/api/alimtalk"
    },
    {
      "source": "/api/:match*",
      "destination": "https://heartsync-5tbs.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
