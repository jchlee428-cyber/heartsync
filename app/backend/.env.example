# ==============================================================================
# HeartSync Backend Environment Configuration
# ==============================================================================

# Application Environment (dev | production)
ENVIRONMENT=dev
PORT=8000
HOST=0.0.0.0
DEBUG=false

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Local Development (Default SQLite):
DATABASE_URL=sqlite+aiosqlite:///dev.db

# Production (PostgreSQL - Supabase / Neon / Render / AWS RDS):
# Replace with your actual PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# Or Neon:
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[ENDPOINT].us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Security & JWT Authentication
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_EXPIRE_MINUTES=1440
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration (Toss Payments)
# ------------------------------------------------------------------------------
# Test secret key (starts with test_sk_) or Live secret key (starts with live_sk_):
TOSS_SECRET_KEY=test_sk_Z4wYG57r0314wvDk1N4V3k6bApiKey
# Toss Payments Client Key (test_ck_... for test, live_ck_... for live):
TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gmeYBlNkw

# Optional: Stripe Payment Gateway
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. AI & LLM Service Configuration
# ------------------------------------------------------------------------------
# API Key for generating psychological diagnostic reports and AI coaching:
APP_AI_KEY=
APP_AI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. Frontend & Domain Configuration
# ------------------------------------------------------------------------------
FRONTEND_URL=https://heartsync.kr
